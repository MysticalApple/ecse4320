# Edit here, nothing else needs to change. Sourced by scripts/common.sh.

# --- test file: one big file on the ext4 root partition of the 990 Pro ---
TESTFILE=/fio-testfile
FILE_SIZE_G=256               # GiB; fully written by setup.sh
EXPECTED_DEV=/dev/nvme0n1p2   # setup.sh aborts if TESTFILE is not on this device
NVME_CTRL=nvme0               # for the temperature sensor in /sys/class/nvme
IOENGINE=io_uring             # or libaio

# --- timing (seconds) ---
RUNTIME=10                    # measured time of a normal run
RAMP=2                        # discarded warm-up before each run
REPS=3                        # repetitions per data point
BASE_RUNTIME=30               # zero-queue baseline runs
TAIL_RUNTIME=60               # tail-latency runs
TAIL_REPS=2
TAIL_QDS="8 32"               # mid-QD and near-knee QD; adjust after looking at the qdsweep
STATE_SECS=600                # sustained sequential write for the device-state test
SETTLE_SEC=300                # idle after preconditioning (SLC cache drain)
IDLE_SEC=60                   # idle before the device-state test

# --- thermals ---
TEMP_MAX_C=55                 # wait for the drive to cool below this before each experiment
COOL_TIMEOUT=300              # ...but never wait longer than this (s)
